yyyyy/urls.py


from django.urls import path
from . import views

urlpatterns=[
    path('', views.home, name='home'),
    path('home/', views.home, name='home'),
    
] 



yyyyy/views.py

from django.shortcuts import render

# Create your views here.
def home(request):
    return render(request, 'home.html')



